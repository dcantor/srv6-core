#cloud-config
# dc4-h2: eth0 = OOB management (10.3.0.54), eth1 = ce4 eth4 (dc4 LAN 172.21.4.0/24, gateway 172.21.4.1)
hostname: dc4-h2
users:
  - name: lab
    plain_text_passwd: lab
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/sh
ssh_pwauth: true
write_files:
  - path: /etc/motd
    content: "dc4-h2 — dc4 tenant host: eth1 172.21.4.2/24 (gateway 172.21.4.1), OOB eth0 10.3.0.54. iperf3 / tcpdump / mtr installed.\n"
runcmd:
  - rc-update add sshd default
  - rc-service sshd restart
  - rc-update add node-exporter default
  - rc-service node-exporter restart
