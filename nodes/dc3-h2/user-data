#cloud-config
# dc3-h2: eth0 = OOB management (10.3.0.53), eth1 = ce3 eth4 (dc3 LAN 172.21.3.0/24 + fd00:21:3::/64, gateways 172.21.3.1 / fd00:21:3::1)
hostname: dc3-h2
users:
  - name: lab
    plain_text_passwd: lab
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/sh
ssh_pwauth: true
write_files:
  - path: /etc/motd
    content: "dc3-h2 — dc3 tenant host: eth1 172.21.3.2/24 (gateway 172.21.3.1), OOB eth0 10.3.0.53. iperf3 / tcpdump / mtr installed.\n"
runcmd:
  - rc-update add sshd default
  - rc-service sshd restart
  - rc-update add node-exporter default
  - rc-service node-exporter restart
