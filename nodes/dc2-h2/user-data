#cloud-config
# dc2-h2: eth0 = OOB management (10.3.0.52), eth1 = ce2 eth4 (dc2 LAN 172.21.2.0/24, gateway 172.21.2.1)
hostname: dc2-h2
users:
  - name: lab
    plain_text_passwd: lab
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/sh
ssh_pwauth: true
write_files:
  - path: /etc/motd
    content: "dc2-h2 — dc2 tenant host: eth1 172.21.2.2/24 (gateway 172.21.2.1), OOB eth0 10.3.0.52. iperf3 / tcpdump / mtr installed.\n"
runcmd:
  - rc-update add sshd default
  - rc-service sshd restart
