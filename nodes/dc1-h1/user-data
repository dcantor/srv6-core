#cloud-config
# dc1-h1: eth0 = OOB management (10.3.0.41), eth1 = ce1 eth2 (dc1 LAN 172.20.1.0/24, gateway 172.20.1.1)
hostname: dc1-h1
users:
  - name: lab
    plain_text_passwd: lab
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/sh
ssh_pwauth: true
write_files:
  - path: /etc/motd
    content: "dc1-h1 — dc1 tenant host: eth1 172.20.1.2/24 (gateway 172.20.1.1), OOB eth0 10.3.0.41. iperf3 / tcpdump / mtr installed.\n"
runcmd:
  - rc-update add sshd default
  - rc-service sshd restart
  - rc-update add node-exporter default
  - rc-service node-exporter restart
